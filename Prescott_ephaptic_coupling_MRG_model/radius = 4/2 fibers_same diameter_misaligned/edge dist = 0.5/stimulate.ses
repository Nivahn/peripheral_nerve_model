{load_file("nrngui.hoc")}
objectvar save_window_, rvp_
objectvar scene_vector_[8]
objectvar ocbox_, ocbox_list_, scene_, scene_list_
{ocbox_list_ = new List()  scene_list_ = new List()}
{pwman_place(0,0,0)}

//Begin I/V Clamp Electrode
{
load_file("electrod.hoc")
}
{
ocbox_=new Electrode(0)
execute("can_locate=1 sec=\"node[0]\" xloc=0.5 locate(0)", ocbox_)
execute("vc.dur[0]=1 vc.amp[0]=-80", ocbox_)
execute("vc.dur[1]=0.01 vc.amp[1]=0", ocbox_)
execute("vc.dur[2]=0 vc.amp[2]=-65", ocbox_)
execute("stim.del=0 stim.dur=0 stim.amp=0", ocbox_)
execute("vcsteps=5", ocbox_)
execute("samp=stim.amp  store_vclamp() glyph()", ocbox_)
ocbox_ = ocbox_.v1
ocbox_.map("I/V Clamp Electrode", 132, 220, 251.1, 473.4)
}
objref ocbox_
//End I/V Clamp Electrode

{
xpanel("RunControl", 0)
v_init = -80
xvalue("Init","v_init", 1,"stdinit()", 1, 1 )
xbutton("Init & Run","run()")
xbutton("Stop","stoprun=1")
runStopAt = 5
xvalue("Continue til","runStopAt", 1,"{continuerun(runStopAt) stoprun=1}", 1, 1 )
runStopIn = 1
xvalue("Continue for","runStopIn", 1,"{continuerun(t + runStopIn) stoprun=1}", 1, 1 )
xbutton("Single Step","steprun()")
t = 0
xvalue("t","t", 2 )
tstop = 10
xvalue("Tstop","tstop", 1,"tstop_changed()", 0, 1 )
dt = 0.005
xvalue("dt","dt", 1,"setdt()", 0, 1 )
steps_per_ms = 200
xvalue("Points plotted/ms","steps_per_ms", 1,"setdt()", 0, 1 )
screen_update_invl = 0.05
xvalue("Scrn update invl","screen_update_invl", 1,"", 0, 1 )
realtime = 0
xvalue("Real Time","realtime", 0,"", 0, 1 )
xpanel(470,225)
}
{
save_window_ = new Graph(0)
save_window_.size(0,10,-80,40)
scene_vector_[3] = save_window_
{save_window_.view(0, -80, 10, 120, 778, 62, 300.6, 200.8)}
graphList[0].append(save_window_)
save_window_.save_name("graphList[0].")
save_window_.addvar("node[0].v( 0.5 )", 1, 1, 0.8, 0.9, 2)
}
