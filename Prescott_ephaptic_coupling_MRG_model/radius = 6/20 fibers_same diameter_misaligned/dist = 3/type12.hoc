/*--------------------------------------------------------------------
2/02
Cameron C. McIntyre
SIMULATION OF PNS MYELINATED AXON

This model is described in detail in:

McIntyre CC, Richardson AG, and Grill WM. Modeling the excitability of
mammalian nerve fibers: influence of afterpotentials on the recovery
cycle. Journal of Neurophysiology 87:995-1006, 2002.

This model can not be used with NEURON v5.1 as errors in the
extracellular mechanism of v5.1 exist related to xc. The original
stimulations were run on v4.3.1. NEURON v5.2 has corrected the 
limitations in v5.1 and can be used to run this model.
----------------------------------------------------------------------*/



xopen("fixnseg.hoc") 



//load_proc("nrnmainmenu")

proc model_globels() {			
	celsius=37			
	v_init=-80 //mV//  		        	
	tstop=10
//Intracellular stimuluation parameters//	
	istim=2				
	delay=1				
	pw=0.1
//topological parameters//	
	
	axonnodes= 36			//*change
	paranodes1=2*axonnodes
	paranodes2=10*axonnodes	
	axoninter=40*axonnodes			
			 
//morphological parameters//
	
	fiberD=	6.0000011*2                  //*change
	paralength1=3  
	nodelength=1.0
	space_p1=0.002  
	space_p2=0.004
	space_i=0.004
//electrical parameters//		
	rhoa=0.7e6 //Ohm-um//
	mycm=0.1 //uF/cm2/lamella membrane//
	mygm=0.001 //S/cm2/lamella membrane//
	}
model_globels ()

proc dependent_var() {

	axonD= 8.56624000000000
        nodeD= 3.92687600000000
      
        deltax= 1305.64000000000
        paralength2= 10.1532800000000
        nl= 132                  //*change
        interlength= 29.9276800000000         //*change             //(deltax-nodelength-(2*paralength1)-(2*paralength2))/6


        paraD1=nodeD 
        paraD2=axonD

	Rpn0=(rhoa*.01)/(PI*((((nodeD/2)+space_p1)^2)-((nodeD/2)^2)))
	Rpn1=(rhoa*.01)/(PI*((((paraD1/2)+space_p1)^2)-((paraD1/2)^2)))
	Rpn2=(rhoa*.01)/(PI*((((paraD2/2)+space_p2)^2)-((paraD2/2)^2)))
	Rpx=(rhoa*.01)/(PI*((((axonD/2)+space_i)^2)-((axonD/2)^2)))
	
	}
dependent_var()

objectvar stim

create node[axonnodes], MYSA[paranodes1], FLUT[paranodes2], STIN[axoninter]
create soma
access node[0]	//APD

proc initialize(){







soma{
nseg=1
diam=fiberD   
L=0.01
Ra=rhoa*(1/(paraD1/fiberD)^2)/10000
cm=cm=2*paraD1/fiberD
insert pas
g_pas=0.001*paraD1/fiberD		
e_pas=-80
insert extracellular xraxial=Rpn1 xg=mygm/(nl*2) xc=mycm/(nl*2)  
}






	for i=0,axonnodes-1 {
		node[i]{					
			nseg=1
			diam=nodeD
			L=nodelength
			Ra=rhoa/10000
			cm=2
		        insert axnode			
		 	insert extracellular xraxial=Rpn0 xg=1e10 xc=0  
			}
		}
	for i=0, paranodes1-1 {
		MYSA[i]{
			nseg=1
			diam=fiberD
			L=paralength1
			Ra=rhoa*(1/(paraD1/fiberD)^2)/10000
			cm=2*paraD1/fiberD
			insert pas
			g_pas=0.001*paraD1/fiberD		
			e_pas=-80
			insert extracellular xraxial=Rpn1 xg=mygm/(nl*2) xc=mycm/(nl*2)  
			}
	}
	for i=0, paranodes2-1 {
		FLUT[i]{
			nseg=1
			diam=fiberD
			L=paralength2
			Ra=rhoa*(1/(paraD2/fiberD)^2)/10000
			cm=2*paraD2/fiberD
			insert pas
			g_pas=0.0001*paraD2/fiberD		
			e_pas=-80
			insert extracellular xraxial=Rpn2 xg=mygm/(nl*2) xc=mycm/(nl*2)   
			}
	}
	for i=0, axoninter-1 {
		STIN[i]{
			nseg=1
			diam=fiberD
			L=interlength
			Ra=rhoa*(1/(axonD/fiberD)^2)/10000
			cm=2*axonD/fiberD
			insert pas
			g_pas=0.0001*axonD/fiberD
			e_pas=-80
			insert extracellular xraxial=Rpx xg=mygm/(nl*2) xc=mycm/(nl*2)    
			}
	}





	for i=0, axonnodes-2 {
		connect MYSA[2*i](0), node[i](1)

		connect FLUT[10*i](0), MYSA[2*i](1)
                connect FLUT[10*i+1](0), FLUT[10*i](1)
                connect FLUT[10*i+2](0), FLUT[10*i+1](1)
                connect FLUT[10*i+3](0), FLUT[10*i+2](1)
                connect FLUT[10*i+4](0), FLUT[10*i+3](1)










		connect STIN[40*i](0), FLUT[10*i+4](1)
		connect STIN[40*i+1](0), STIN[40*i](1)
		connect STIN[40*i+2](0), STIN[40*i+1](1)
		connect STIN[40*i+3](0), STIN[40*i+2](1)
		connect STIN[40*i+4](0), STIN[40*i+3](1)	
		connect STIN[40*i+5](0), STIN[40*i+4](1)	
                connect STIN[40*i+6](0), STIN[40*i+5](1)
                connect STIN[40*i+7](0), STIN[40*i+6](1)
                connect STIN[40*i+8](0), STIN[40*i+7](1)
                connect STIN[40*i+9](0), STIN[40*i+8](1)
                connect STIN[40*i+10](0), STIN[40*i+9](1)
                connect STIN[40*i+11](0), STIN[40*i+10](1)
                connect STIN[40*i+12](0), STIN[40*i+11](1)
                connect STIN[40*i+13](0), STIN[40*i+12](1)
                connect STIN[40*i+14](0), STIN[40*i+13](1)
                connect STIN[40*i+15](0), STIN[40*i+14](1)
                connect STIN[40*i+16](0), STIN[40*i+15](1)
                connect STIN[40*i+17](0), STIN[40*i+16](1)
                connect STIN[40*i+18](0), STIN[40*i+17](1)
                connect STIN[40*i+19](0), STIN[40*i+18](1)
                connect STIN[40*i+20](0), STIN[40*i+19](1)
                connect STIN[40*i+21](0), STIN[40*i+20](1)
                connect STIN[40*i+22](0), STIN[40*i+21](1)
                connect STIN[40*i+23](0), STIN[40*i+22](1)
                connect STIN[40*i+24](0), STIN[40*i+23](1)
                connect STIN[40*i+25](0), STIN[40*i+24](1)
                connect STIN[40*i+26](0), STIN[40*i+25](1)
                connect STIN[40*i+27](0), STIN[40*i+26](1)
                connect STIN[40*i+28](0), STIN[40*i+27](1)
                connect STIN[40*i+29](0), STIN[40*i+28](1)
                connect STIN[40*i+30](0), STIN[40*i+29](1)
                connect STIN[40*i+31](0), STIN[40*i+30](1)
                connect STIN[40*i+32](0), STIN[40*i+31](1)
                connect STIN[40*i+33](0), STIN[40*i+32](1)
                connect STIN[40*i+34](0), STIN[40*i+33](1)
                connect STIN[40*i+35](0), STIN[40*i+34](1)
                connect STIN[40*i+36](0), STIN[40*i+35](1)
                connect STIN[40*i+37](0), STIN[40*i+36](1)
                connect STIN[40*i+38](0), STIN[40*i+37](1)
                connect STIN[40*i+39](0), STIN[40*i+38](1)

		connect FLUT[10*i+5](0), STIN[40*i+39](1)
		connect FLUT[10*i+6](0), FLUT[10*i+5](1)
		connect FLUT[10*i+7](0), FLUT[10*i+6](1)
		connect FLUT[10*i+8](0), FLUT[10*i+7](1)
		connect FLUT[10*i+9](0), FLUT[10*i+8](1)

		connect MYSA[2*i+1](0), FLUT[10*i+9](1)
		connect node[i+1](0), MYSA[2*i+1](1)	
		}





i=axonnodes-1
connect MYSA[2*i](0), node[i](1)
connect FLUT[10*i](0), MYSA[2*i](1)
connect FLUT[10*i+1](0), FLUT[10*i](1)
connect FLUT[10*i+2](0), FLUT[10*i+1](1)
connect FLUT[10*i+3](0), FLUT[10*i+2](1)
connect FLUT[10*i+4](0), FLUT[10*i+3](1)

		connect STIN[40*i](0), FLUT[10*i+4](1)
		connect STIN[40*i+1](0), STIN[40*i](1)
		connect STIN[40*i+2](0), STIN[40*i+1](1)
		connect STIN[40*i+3](0), STIN[40*i+2](1)
		connect STIN[40*i+4](0), STIN[40*i+3](1)	
		connect STIN[40*i+5](0), STIN[40*i+4](1)	
                connect STIN[40*i+6](0), STIN[40*i+5](1)
                connect STIN[40*i+7](0), STIN[40*i+6](1)
                connect STIN[40*i+8](0), STIN[40*i+7](1)
                connect STIN[40*i+9](0), STIN[40*i+8](1)
                connect STIN[40*i+10](0), STIN[40*i+9](1)
                connect STIN[40*i+11](0), STIN[40*i+10](1)
                connect STIN[40*i+12](0), STIN[40*i+11](1)
                connect STIN[40*i+13](0), STIN[40*i+12](1)
                connect STIN[40*i+14](0), STIN[40*i+13](1)
                connect STIN[40*i+15](0), STIN[40*i+14](1)
                connect STIN[40*i+16](0), STIN[40*i+15](1)
                connect STIN[40*i+17](0), STIN[40*i+16](1)
                connect STIN[40*i+18](0), STIN[40*i+17](1)
                connect STIN[40*i+19](0), STIN[40*i+18](1)
                connect STIN[40*i+20](0), STIN[40*i+19](1)
                connect STIN[40*i+21](0), STIN[40*i+20](1)
                connect STIN[40*i+22](0), STIN[40*i+21](1)
                connect STIN[40*i+23](0), STIN[40*i+22](1)
                connect STIN[40*i+24](0), STIN[40*i+23](1)
                connect STIN[40*i+25](0), STIN[40*i+24](1)
                connect STIN[40*i+26](0), STIN[40*i+25](1)
                connect STIN[40*i+27](0), STIN[40*i+26](1)
                connect STIN[40*i+28](0), STIN[40*i+27](1)
                connect STIN[40*i+29](0), STIN[40*i+28](1)
                connect STIN[40*i+30](0), STIN[40*i+29](1)
                connect STIN[40*i+31](0), STIN[40*i+30](1)
                connect STIN[40*i+32](0), STIN[40*i+31](1)
                connect STIN[40*i+33](0), STIN[40*i+32](1)
                connect STIN[40*i+34](0), STIN[40*i+33](1)
                connect STIN[40*i+35](0), STIN[40*i+34](1)
                connect STIN[40*i+36](0), STIN[40*i+35](1)
                connect STIN[40*i+37](0), STIN[40*i+36](1)
                connect STIN[40*i+38](0), STIN[40*i+37](1)
                connect STIN[40*i+39](0), STIN[40*i+38](1)



connect FLUT[10*i+5](0), STIN[40*i+39](1)
connect FLUT[10*i+6](0), FLUT[10*i+5](1)
connect FLUT[10*i+7](0), FLUT[10*i+6](1)
connect FLUT[10*i+8](0), FLUT[10*i+7](1)
connect FLUT[10*i+9](0), FLUT[10*i+8](1)


connect MYSA[2*i+1](0), FLUT[10*i+9](1)


connect soma(0), MYSA[2*i+1](1)



	finitialize(v_init)
	fcurrent()
}




initialize()




//intracellular stimulus//

